# ============================================================================
# AGENT 3D TOPOLOGY SERVER & MCP HUB - CONFIGURATION (.env)
# ============================================================================

# 1. Server Port (Default: 3300)
PORT=3300

# 2. Public Base URL (Optional)
# Leave empty to auto-detect from incoming HTTP/Proxy headers (localhost, LAN IP, Cloudflare Tunnel, Ngrok).
# Or set explicitly when behind a fixed custom domain, e.g., https://agents.yourdomain.com
PUBLIC_BASE_URL=

# 3. Security & Authentication Mode
# - MASTER_API_KEY: Leave empty for easy plug-and-play (any local tool/MCP can create sessions,
#   and each session still gets its own secret authToken & viewToken).
#   Set a strong secret if exposing session creation publicly on the internet.
MASTER_API_KEY=

# - ALLOW_ANONYMOUS_PUSH: Leave "false" (default). When false, updating an EXISTING room via
#   POST /api/push requires that room's authToken (returned when the room was created).
#   Set to "true" ONLY on a trusted private network: it lets anyone who knows a sessionId
#   overwrite that room's agents.
ALLOW_ANONYMOUS_PUSH=false

# - REQUIRE_VIEW_TOKEN: Set to "true" (default) so viewers must have the session's viewToken
#   in the URL (?token=vt_...) to watch a room. Set to "false" to allow public viewing by room ID.
REQUIRE_VIEW_TOKEN=true

# - ALLOW_WS_AUTOCREATE: Leave "false" (default). When false, a WebSocket connect to an
#   unknown room id is refused instead of silently creating a public room. Enabling it
#   lets any unauthenticated client mint sessions and, through MAX_SESSIONS LRU eviction,
#   push every real room out of memory.
ALLOW_WS_AUTOCREATE=false

# 4. Resource Limits & Auto-Cleanup (24/7 Mac Mini / VPS Optimization)
MAX_SESSIONS=200
SESSION_TTL_HOURS=24
MAX_EVENTS_PER_SESSION=60
DATA_DIR=./data

# 5. Default UI Language ("vi" or "en")
DEFAULT_LANG=vi

# 6. Cloudflare Tunnel Token (Optional - used with: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=
